# Large generated simulation/scenario data — kept locally for running
# simulations from this repo, but never pushed to the remote.
scentree-gen-remote/same_ren_scentree/*
!scentree-gen-remote/same_ren_scentree/.gitkeep

scentree-gen-remote/dif_ren_scentree/*
!scentree-gen-remote/dif_ren_scentree/.gitkeep

scentree-gen-remote/scenarios_AMPL/*
!scentree-gen-remote/scenarios_AMPL/.gitkeep

# Python / environment clutter
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/
*.egg-info/

# Raw per-run solution exports (~280 MB, 5385 small .txt files). Kept locally
# so the analysis notebooks can be re-run against them, but never pushed:
# committing them and deleting them in a later commit would leave them in the
# repository history for good, so they are excluded from the start.
Results/Execution of model/results/*
!Results/Execution of model/results/.gitkeep
